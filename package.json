{
  "name": "rugtown",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "world:prepare": "node scripts/sync-world-assets.mjs && node scripts/generate-world-asset-manifest.mjs && node scripts/analyze-world-asset-visual-bounds.mjs",
    "world:generate": "node scripts/generate-compact-world-placement-manifest.mjs && node scripts/generate-compact-world-prop-manifest.mjs && node scripts/generate-compact-world-filler-buildings.mjs && node scripts/generate-compact-world-ground.mjs && node scripts/sync-world-assets.mjs",
    "world:validate": "node scripts/validate-world-assets.mjs && node scripts/validate-world-ground.mjs && node scripts/validate-npc-population.mjs",
    "world:full": "node scripts/clean-world-asset-transparency.mjs && npm run world:generate && npm run world:prepare && npm run world:validate",
    "sync:world-assets": "node scripts/sync-world-assets.mjs",
    "clean:world-transparency": "node scripts/clean-world-asset-transparency.mjs",
    "generate:world-library": "node scripts/generate-world-asset-manifest.mjs",
    "generate:world-placement": "node scripts/generate-compact-world-placement-manifest.mjs",
    "generate:world-props": "node scripts/generate-compact-world-prop-manifest.mjs",
    "generate:world-filler": "node scripts/generate-compact-world-filler-buildings.mjs",
    "generate:world-ground": "node scripts/generate-compact-world-ground.mjs",
    "analyze:world-bounds": "node scripts/analyze-world-asset-visual-bounds.mjs",
    "export:blueprint": "node scripts/export-art-blueprint.mjs",
    "report:travel-time": "node scripts/travel-time-report.mjs",
    "validate:world-assets": "node scripts/validate-world-assets.mjs",
    "validate:world-ground": "node scripts/validate-world-ground.mjs",
    "validate:npc-population": "node scripts/validate-npc-population.mjs",
    "validate:world-geometry-10a": "node scripts/validate-world-geometry-10a.mjs",
    "generate:minimap-texture": "node scripts/generate-minimap-texture.mjs",
    "validate:minimap-10c": "node scripts/validate-minimap-10c.mjs",
    "validate:interaction-10d": "node scripts/validate-interaction-10d.mjs",
    "ingest:character-art": "node scripts/ingest-character-art.mjs",
    "assets:characters": "node scripts/install-character-assets.mjs",
    "validate:characters": "node scripts/validate-character-bitmap-system.mjs",
    "test:character-appearance": "node scripts/test-character-appearance-codec.mjs",
    "test:character-placement-npc": "node scripts/test-character-placement-and-npc-tuning.mjs",
    "analyze:character-bounds": "node scripts/analyze-character-asset-bounds.mjs",
    "test:session-store": "node scripts/test-session-store.mjs",
    "test:gameplay-completion": "npx tsx scripts/test-gameplay-completion.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "phaser": "^3.60.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "sharp": "^0.35.3",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
