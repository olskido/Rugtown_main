# RugTown environment variables
# Copy to .env.local (gitignored). Never commit real keys.

# ─── Browser-safe (VITE_*) ───────────────────────────────────────────────────
# Anon key is public; RLS enforces access. Never put service_role here.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional public token flags (Pump.fun post-launch). Disabled by default.
# Private RPC / mint activation secrets stay in Edge Function secrets only.
VITE_RUGTOWN_TOKEN_ENABLED=false
VITE_RUGTOWN_TOKEN_MINT_ADDRESS=
VITE_RUGTOWN_TOKEN_CLUSTER=mainnet-beta
VITE_RUGTOWN_TOKEN_FEATURE_VERSION=1

# ─── Edge Function SERVER-ONLY secrets (supabase secrets set) ────────────────
# NEVER prefix with VITE_ / NEXT_PUBLIC_ and NEVER commit real values.
#
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
#   SOLANA_CLUSTER=devnet|testnet|mainnet-beta
#   SOLANA_RPC_ENDPOINT=https://…   (private provider URL OK here)
#   TREASURY_PUBLIC_ADDRESS=…       (public address only — never a private key)
#   SETTLEMENT_MODE=disabled
#   SETTLEMENT_MIN_CONFIRMATIONS=finalized
#   SETTLEMENT_VERIFICATION_TIMEOUT_MS=15000
#   ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain
#
# Auth email confirmation (Supabase Dashboard → Authentication → URL Configuration):
#   Site URL     = https://your-production-domain   (or http://localhost:3000 while developing)
#   Redirect URLs must include BOTH:
#     http://localhost:3000/auth/callback
#     https://your-production-domain/auth/callback
# The app always sends emailRedirectTo = `${window.location.origin}/auth/callback`
# (never a hardcoded localhost URL in code).
#
# Vercel Production (Settings → Environment Variables) — required for multiplayer:
#   VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
#   VITE_SUPABASE_ANON_KEY=your-anon-public-key
# These are baked in at BUILD time. After changing them, Redeploy Production.
# Preview deployments need the same vars under the Preview environment too.
#
# Post Pump.fun launch (server secrets — not VITE_):
#   RUGTOWN_TOKEN_ENABLED=false
#   RUGTOWN_TOKEN_MINT_ADDRESS=
#   RUGTOWN_TOKEN_CLUSTER=mainnet-beta
#   RUGTOWN_TOKEN_MIN_CONFIRMATIONS=finalized
#   RUGTOWN_TOKEN_BALANCE_CACHE_SECONDS=60
#   RUGTOWN_TOKEN_RPC_PROVIDER=
#   RUGTOWN_TOKEN_FEATURE_VERSION=1
